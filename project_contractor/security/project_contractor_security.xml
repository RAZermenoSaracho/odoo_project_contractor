<odoo>
 <record id="group_contractor" model="res.groups"><field name="name">Contractor</field><field name="implied_ids" eval="[(4, ref('base.group_user'))]"/></record>
 <record id="rule_contractor_partner" model="ir.rule"><field name="name">Contractor own contact</field><field name="model_id" ref="base.model_res_partner"/><field name="domain_force">[('id', '=', user.partner_id.id)] if user.is_contractor_user else []</field><field name="global" eval="True"/></record>
 <record id="rule_contractor_contract_read" model="ir.rule"><field name="name">Contractor published Contracts</field><field name="model_id" ref="model_contract_contract"/><field name="domain_force">[('state', '=', 'published')]</field><field name="groups" eval="[(4, ref('project_contractor.group_contractor'))]"/><field name="perm_write" eval="False"/><field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/></record>
 <record id="rule_customer_contract" model="ir.rule"><field name="name">Customer commercial Contracts</field><field name="model_id" ref="model_contract_contract"/><field name="domain_force">[('partner_id.commercial_partner_id', '=', user.partner_id.commercial_partner_id.id)]</field><field name="groups" eval="[(4, ref('base.group_portal'))]"/></record>
 <record id="rule_contractor_proposal" model="ir.rule"><field name="name">Contractor own Proposals</field><field name="model_id" ref="model_contract_proposal"/><field name="domain_force">[('contractor_id', '=', user.partner_id.id)]</field><field name="groups" eval="[(4, ref('project_contractor.group_contractor'))]"/></record>
 <record id="rule_customer_proposal" model="ir.rule"><field name="name">Customer commercial Contract Proposals</field><field name="model_id" ref="model_contract_proposal"/><field name="domain_force">[('contract_id.partner_id.commercial_partner_id', '=', user.partner_id.commercial_partner_id.id)]</field><field name="groups" eval="[(4, ref('base.group_portal'))]"/></record>
 <record id="rule_contractor_project_read" model="ir.rule"><field name="name">Assigned Contractor Projects</field><field name="model_id" ref="project.model_project_project"/><field name="domain_force">[('primary_contractor_id.user_ids', 'in', user.id)] if user.is_contractor_user else []</field><field name="global" eval="True"/><field name="perm_write" eval="False"/><field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/></record>
 <record id="rule_contractor_project_write" model="ir.rule"><field name="name">Assigned Contractor Project writes</field><field name="model_id" ref="project.model_project_project"/><field name="domain_force">[('primary_contractor_id.user_ids', 'in', user.id)] if user.is_contractor_user else []</field><field name="global" eval="True"/><field name="perm_read" eval="False"/><field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/></record>
 <record id="rule_contractor_task_read" model="ir.rule"><field name="name">Assigned Contractor Tasks</field><field name="model_id" ref="project.model_project_task"/><field name="domain_force">[('project_id.primary_contractor_id.user_ids', 'in', user.id)] if user.is_contractor_user else []</field><field name="global" eval="True"/><field name="perm_write" eval="False"/><field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/></record>
 <record id="rule_contractor_task_write" model="ir.rule"><field name="name">Assigned Contractor Task mutations</field><field name="model_id" ref="project.model_project_task"/><field name="domain_force">[('project_id.primary_contractor_id.user_ids', 'in', user.id)] if user.is_contractor_user else []</field><field name="global" eval="True"/><field name="perm_read" eval="False"/><field name="perm_create" eval="False"/></record>
 <record id="rule_contractor_task_assigned_scope" model="ir.rule"><field name="name">Assigned Contractor Task operation scope</field><field name="model_id" ref="project.model_project_task"/><field name="domain_force">[('project_id.primary_contractor_id.user_ids', 'in', user.id)]</field><field name="groups" eval="[(4, ref('project_contractor.group_contractor'))]"/><field name="perm_read" eval="False"/><field name="perm_create" eval="False"/></record>
</odoo>
