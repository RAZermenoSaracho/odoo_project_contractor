<odoo>
 <record id="group_contractor" model="res.groups"><field name="name">Contractor</field><field name="implied_ids" eval="[(4, ref('base.group_user'))]"/></record>
 <record id="rule_contractor_partner" model="ir.rule"><field name="name">Contractor own contact</field><field name="model_id" ref="base.model_res_partner"/><field name="domain_force">[('id', '=', user.partner_id.id)] if user.is_contractor_user else []</field><field name="global" eval="True"/></record>
 <record id="rule_contractor_project_read" model="ir.rule"><field name="name">Contractor readable Project Contracts</field><field name="model_id" ref="project.model_project_project"/><field name="domain_force">['|', '|', ('contractor_lifecycle', '=', 'discoverable'), ('candidate_contractor_ids.user_ids', 'in', user.id), ('primary_contractor_id.user_ids', 'in', user.id)] if user.is_contractor_user else []</field><field name="global" eval="True"/><field name="perm_write" eval="False"/><field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/></record>
 <record id="rule_contractor_project_write" model="ir.rule"><field name="name">Assigned Contractor Project writes</field><field name="model_id" ref="project.model_project_project"/><field name="domain_force">[('contractor_lifecycle', '=', 'assigned'), ('primary_contractor_id.user_ids', 'in', user.id)] if user.is_contractor_user else []</field><field name="global" eval="True"/><field name="perm_read" eval="False"/><field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/></record>
 <record id="rule_contractor_task_read" model="ir.rule"><field name="name">Contractor readable Project Contract Tasks</field><field name="model_id" ref="project.model_project_task"/><field name="domain_force">['|', '|', ('project_id.contractor_lifecycle', '=', 'discoverable'), ('project_id.candidate_contractor_ids.user_ids', 'in', user.id), ('project_id.primary_contractor_id.user_ids', 'in', user.id)] if user.is_contractor_user else []</field><field name="global" eval="True"/><field name="perm_write" eval="False"/><field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/></record>
 <record id="rule_contractor_task_write" model="ir.rule"><field name="name">Assigned Contractor Task mutations</field><field name="model_id" ref="project.model_project_task"/><field name="domain_force">[('project_id.contractor_lifecycle', '=', 'assigned'), ('project_id.primary_contractor_id.user_ids', 'in', user.id)] if user.is_contractor_user else []</field><field name="global" eval="True"/><field name="perm_read" eval="False"/><field name="perm_create" eval="False"/></record>
 <record id="rule_contractor_task_assigned_scope" model="ir.rule"><field name="name">Assigned Contractor Task operation scope</field><field name="model_id" ref="project.model_project_task"/><field name="domain_force">[('project_id.contractor_lifecycle', '=', 'assigned'), ('project_id.primary_contractor_id.user_ids', 'in', user.id)]</field><field name="groups" eval="[(4, ref('project_contractor.group_contractor'))]"/><field name="perm_read" eval="False"/><field name="perm_create" eval="False"/></record>
</odoo>
