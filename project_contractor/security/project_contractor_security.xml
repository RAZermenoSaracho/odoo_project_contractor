<odoo>
 <record id="group_contractor" model="res.groups"><field name="name">Contractor</field><field name="implied_ids" eval="[(4, ref('base.group_user'))]"/></record>
 <record id="rule_contractor_partner" model="ir.rule"><field name="name">Contractor own contact</field><field name="model_id" ref="base.model_res_partner"/><field name="domain_force">[('id', '=', user.partner_id.id)] if user.is_contractor_user else []</field><field name="global" eval="True"/></record>
 <record id="rule_contractor_project" model="ir.rule"><field name="name">Contractor projects</field><field name="model_id" ref="project.model_project_project"/><field name="domain_force">['|', ('contractor_user_ids', 'in', user.id), ('has_contractor_assignment', '=', False)] if user.is_contractor_user else []</field><field name="global" eval="True"/></record>
 <record id="rule_contractor_task" model="ir.rule"><field name="name">Contractor tasks</field><field name="model_id" ref="project.model_project_task"/><field name="domain_force">['|', '|', ('user_ids', 'in', user.id), ('contractor_id.user_ids', 'in', user.id), ('project_id.has_contractor_assignment', '=', False)] if user.is_contractor_user else []</field><field name="global" eval="True"/></record>
</odoo>
