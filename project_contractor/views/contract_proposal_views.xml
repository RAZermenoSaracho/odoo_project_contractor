<odoo>
 <record id="view_contract_proposal_tree" model="ir.ui.view"><field name="name">contract.proposal.list</field><field name="model">contract.proposal</field><field name="arch" type="xml"><list><field name="contract_id"/><field name="contractor_id"/><field name="amount"/><field name="currency_id"/><field name="state"/></list></field></record>
 <record id="view_contract_proposal_form" model="ir.ui.view"><field name="name">contract.proposal.form</field><field name="model">contract.proposal</field><field name="arch" type="xml"><form><header><button name="action_submit" type="object" string="Submit" invisible="state != 'draft'"/><button name="action_withdraw" type="object" string="Withdraw" invisible="state not in ('draft', 'submitted')"/><button name="action_accept" type="object" string="Accept" invisible="state != 'submitted'"/><button name="action_reject" type="object" string="Reject" invisible="state not in ('draft', 'submitted')"/><field name="state" widget="statusbar"/></header><sheet><group><field name="contract_id" readonly="state != 'draft'"/><field name="contractor_id"/><field name="amount" readonly="state != 'draft'"/><field name="currency_id" readonly="state != 'draft'"/><field name="project_id" readonly="1"/></group></sheet><chatter/></form></field></record>
 <record id="action_contract_proposal" model="ir.actions.act_window"><field name="name">Proposals</field><field name="res_model">contract.proposal</field><field name="view_mode">list,form</field></record>
</odoo>
