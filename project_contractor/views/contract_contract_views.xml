<odoo>
 <record id="view_contract_contract_tree" model="ir.ui.view"><field name="name">contract.contract.list</field><field name="model">contract.contract</field><field name="arch" type="xml"><list><field name="name"/><field name="partner_id"/><field name="state"/></list></field></record>
 <record id="view_contract_contract_form" model="ir.ui.view"><field name="name">contract.contract.form</field><field name="model">contract.contract</field><field name="arch" type="xml"><form><header><button name="action_publish" type="object" string="Publish" invisible="state != 'draft'"/><button name="action_cancel" type="object" string="Cancel" invisible="state not in ('draft', 'published')"/><field name="state" widget="statusbar"/></header><sheet><div name="button_box" class="oe_button_box"><button class="oe_stat_button" type="object" name="action_view_proposals" icon="fa-file-text-o"><field name="proposal_count" string="Proposals" widget="statinfo"/></button><button class="oe_stat_button" type="object" name="action_view_project" icon="fa-puzzle-piece" invisible="not project_id"><div class="o_stat_info"><span class="o_stat_text">Project</span></div></button></div><group><field name="name"/><field name="partner_id"/><field name="accepted_proposal_id" readonly="1"/><field name="project_id" readonly="1"/></group><notebook><page string="Proposals"><field name="proposal_ids" readonly="state in ('awarded', 'cancelled')"><list><field name="contractor_id"/><field name="amount"/><field name="currency_id"/><field name="state"/></list></field></page></notebook></sheet><chatter/></form></field></record>
 <record id="action_contract_contract" model="ir.actions.act_window"><field name="name">Contracts</field><field name="res_model">contract.contract</field><field name="view_mode">list,form</field></record>
 <menuitem id="menu_contract_contract" name="Contracts" parent="project.menu_main_pm" action="action_contract_contract" sequence="35" groups="project.group_project_manager"/>
</odoo>
