<odoo>
 <template id="portal_my_home_contracts" inherit_id="portal.portal_my_home" priority="40"><xpath expr="//div[@id='portal_common_category']" position="inside">
  <t t-if="not request.env.user.is_contractor_user" t-call="portal.portal_docs_entry"><t t-set="title">Contracts</t><t t-set="text">Create and manage your opportunities</t><t t-set="url" t-value="'/my/contracts'"/><t t-set="icon" t-value="False"/><t t-set="config_card" t-value="True"/></t>
  <t t-call="portal.portal_docs_entry"><t t-set="title">Contractor workflow</t><t t-set="text">Browse opportunities and manage proposals</t><t t-set="url" t-value="'/my/contractor'"/><t t-set="icon" t-value="False"/><t t-set="config_card" t-value="True"/></t>
 </xpath></template>

 <template id="contractor_portal_home"><t t-call="portal.portal_layout"><h2>Contractor workflow</h2><t t-if="user.is_contractor_user"><div class="list-group"><a class="list-group-item list-group-item-action" href="/my/contractor/contracts">Browse published Contracts</a><a class="list-group-item list-group-item-action" href="/my/contractor/proposals">My Proposals</a><a class="list-group-item list-group-item-action" href="/my/contractor/projects">My assigned Projects</a></div></t><t t-else=""><p class="text-muted">Activate your existing account to browse Contracts and submit Proposals.</p><form action="/my/contractor/activate" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><button class="btn btn-primary">Become a Contractor</button></form></t></t></template>

 <template id="portal_customer_contracts"><t t-call="portal.portal_layout"><div class="d-flex justify-content-between align-items-center"><h2>My Contracts</h2><a class="btn btn-primary" href="/my/contracts/new">Create Contract</a></div><t t-if="contracts"><div class="list-group mt-3"><a t-foreach="contracts" t-as="contract" t-att-href="'/my/contracts/%s' % contract.id" class="list-group-item list-group-item-action d-flex justify-content-between"><span t-esc="contract.name"/><span class="badge text-bg-secondary" t-esc="contract.state"/></a></div></t><p t-else="" class="text-muted mt-3">No Contracts yet.</p></t></template>
 <template id="portal_customer_contract_form"><t t-call="portal.portal_layout"><h2>Create Contract</h2><p t-if="error" class="alert alert-danger" t-esc="error"/><form action="/my/contracts/create" method="post" class="mt-3"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><div class="mb-3"><label class="form-label" for="name">Opportunity name</label><input id="name" name="name" class="form-control" required="required"/></div><button class="btn btn-primary">Create Contract</button></form></t></template>
 <template id="portal_customer_contract"><t t-call="portal.portal_layout"><div class="d-flex justify-content-between"><h2 t-esc="contract.name"/><span class="badge text-bg-secondary" t-esc="contract.state"/></div><t t-if="contract.state == 'draft'"><form t-att-action="'/my/contracts/%s/update' % contract.id" method="post" class="row g-2 my-3"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><div class="col"><input name="name" class="form-control" t-att-value="contract.name"/></div><div class="col-auto"><button class="btn btn-outline-primary">Save</button></div></form><form t-att-action="'/my/contracts/%s/publish' % contract.id" method="post" class="d-inline"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><button class="btn btn-primary">Publish</button></form></t><t t-if="contract.state in ('draft', 'published')"><form t-att-action="'/my/contracts/%s/cancel' % contract.id" method="post" class="d-inline ms-2"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><button class="btn btn-outline-danger">Cancel</button></form></t><t t-if="contract.state == 'published'"><a t-att-href="'/my/contracts/%s/contractors' % contract.id" class="btn btn-outline-secondary ms-2">Find Contractors</a></t><t t-if="contract.project_id"><a t-att-href="'/my/contracts/%s/projects/%s' % (contract.id, contract.project_id.id)" class="btn btn-success ms-2">Open Project</a></t><h3 class="mt-4">Proposals</h3><t t-if="contract.proposal_ids"><div class="list-group"><a t-foreach="contract.proposal_ids" t-as="proposal" t-att-href="'/my/contracts/%s/proposals/%s' % (contract.id, proposal.id)" class="list-group-item list-group-item-action"><span t-esc="proposal.contractor_id.name"/> — <span t-esc="proposal.amount"/> <span t-esc="proposal.currency_id.name"/> <span class="badge text-bg-secondary float-end" t-esc="proposal.state"/></a></div></t><p t-else="" class="text-muted">No Proposals yet.</p></t></template>
 <template id="portal_contractors"><t t-call="portal.portal_layout"><h2>Contractors</h2><p class="text-muted">Invite a Contractor to start a private draft Proposal.</p><div class="list-group"><div t-foreach="contractors" t-as="contractor" class="list-group-item d-flex justify-content-between"><span t-esc="contractor.name"/><form t-att-action="'/my/contracts/%s/contractors/%s/invite' % (contract.id, contractor.id)" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><button class="btn btn-sm btn-primary">Invite</button></form></div></div></t></template>

 <template id="contractor_portal_contracts"><t t-call="portal.portal_layout"><h2>Published Contracts</h2><div class="list-group"><a t-foreach="contracts" t-as="contract" t-att-href="'/my/contractor/contracts/%s' % contract.id" class="list-group-item list-group-item-action"><span t-esc="contract.name"/><span class="badge text-bg-secondary float-end" t-esc="contract.state"/></a></div><p t-if="not contracts" class="text-muted">No published Contracts are available.</p></t></template>
 <template id="portal_contractor_contract"><t t-call="portal.portal_layout"><h2 t-esc="contract.name"/><t t-if="proposal"><a t-att-href="'/my/contractor/proposals/%s' % proposal.id" class="btn btn-primary">Open my Proposal</a></t><t t-else=""><form t-att-action="'/my/contractor/contracts/%s/proposal/create' % contract.id" method="post" class="row g-2 mt-3"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><div class="col-sm-5"><label class="visually-hidden">Amount</label><input class="form-control" type="number" step="0.01" min="0" name="amount" required="required" placeholder="Proposed amount"/></div><div class="col-auto"><button class="btn btn-primary">Create Proposal</button></div></form></t></t></template>
 <template id="portal_contractor_proposals"><t t-call="portal.portal_layout"><h2>My Proposals</h2><div class="list-group"><a t-foreach="proposals" t-as="proposal" t-att-href="'/my/contractor/proposals/%s' % proposal.id" class="list-group-item list-group-item-action"><span t-esc="proposal.contract_id.name"/> — <span t-esc="proposal.amount"/> <span class="badge text-bg-secondary float-end" t-esc="proposal.state"/></a></div><p t-if="not proposals" class="text-muted">No Proposals yet.</p></t></template>

 <template id="portal_proposal"><t t-call="portal.portal_layout"><div class="d-flex justify-content-between"><h2 t-esc="proposal.contract_id.name"/><span class="badge text-bg-secondary" t-esc="proposal.state"/></div><p><strong>Contractor:</strong> <span t-esc="proposal.contractor_id.name"/></p><p><strong>Amount:</strong> <span t-esc="proposal.amount"/> <span t-esc="proposal.currency_id.name"/></p><t t-if="not customer and proposal.state == 'draft'"><form t-att-action="'/my/contractor/proposals/%s/update' % proposal.id" method="post" class="row g-2"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><div class="col"><input name="amount" type="number" min="0" step="0.01" class="form-control" t-att-value="proposal.amount"/></div><div class="col-auto"><button class="btn btn-outline-primary">Save</button></div></form><form t-att-action="'/my/contractor/proposals/%s/submit' % proposal.id" method="post" class="d-inline mt-2"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><button class="btn btn-primary">Submit</button></form></t><t t-if="not customer and proposal.state in ('draft', 'submitted')"><form t-att-action="'/my/contractor/proposals/%s/withdraw' % proposal.id" method="post" class="d-inline mt-2 ms-2"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><button class="btn btn-outline-danger">Withdraw</button></form></t><t t-if="customer and proposal.state == 'submitted'"><form t-att-action="'/my/contracts/%s/proposals/%s/accept' % (proposal.contract_id.id, proposal.id)" method="post" class="d-inline"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><button class="btn btn-success">Accept</button></form><form t-att-action="'/my/contracts/%s/proposals/%s/reject' % (proposal.contract_id.id, proposal.id)" method="post" class="d-inline ms-2"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><button class="btn btn-outline-danger">Reject</button></form></t><t t-if="proposal.project_id"><a t-att-href="('/my/contracts/%s/projects/%s' % (proposal.contract_id.id, proposal.project_id.id)) if customer else ('/my/contractor/projects/%s' % proposal.project_id.id)" class="btn btn-success ms-2">Open Project</a></t><h3 class="mt-4">Negotiation</h3><div class="list-group mb-3"><div t-foreach="messages" t-as="message" class="list-group-item"><strong t-esc="message.author_id.name"/> <small class="text-muted" t-esc="message.date"/><div t-out="message.body"/></div></div><form t-att-action="post_url" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><textarea name="body" class="form-control" required="required" placeholder="Write a message"/><button class="btn btn-primary mt-2">Send</button></form></t></template>
 <template id="portal_contractor_projects"><t t-call="portal.portal_layout"><h2>My assigned Projects</h2><div class="list-group"><a t-foreach="projects" t-as="project" t-att-href="'/my/contractor/projects/%s' % project.id" class="list-group-item list-group-item-action" t-esc="project.name"/></div><p t-if="not projects" class="text-muted">No assigned Projects yet.</p></t></template>
 <template id="portal_project"><t t-call="portal.portal_layout"><h2 t-esc="project.name"/><p t-if="project.contract_id"><strong>Contract:</strong> <span t-esc="project.contract_id.name"/></p><p><strong>Assigned Contractor:</strong> <span t-esc="project.primary_contractor_id.name"/></p><t t-if="tasks"><h3>Tasks</h3><ul><li t-foreach="tasks" t-as="task" t-esc="task.name"/></ul></t><h3>Operational communication</h3><div class="list-group mb-3"><div t-foreach="messages" t-as="message" class="list-group-item"><strong t-esc="message.author_id.name"/> <small class="text-muted" t-esc="message.date"/><div t-out="message.body"/></div></div><form t-att-action="post_url" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><textarea name="body" class="form-control" required="required" placeholder="Write an operational update"/><button class="btn btn-primary mt-2">Send</button></form></t></template>
</odoo>
